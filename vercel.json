{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/narration.mjs": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "dist/reels/narration-manifest.json"
    }
  },
  "headers": [
    {
      "source": "/reels/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/_syllabus/it248-it-entrepreneurship-management.md",
      "destination": "/_syllabus/IT248-it-entrepreneurship-management.md",
      "permanent": true
    },
    {
      "source": "/_syllabus/it249-business-intelligence.md",
      "destination": "/_syllabus/IT249-business-intelligence.md",
      "permanent": true
    },
    {
      "source": "/_syllabus/it250-digital-economy.md",
      "destination": "/_syllabus/IT250-digital-economy.md",
      "permanent": true
    },
    {
      "source": "/_syllabus/it277-cloud-computing.md",
      "destination": "/_syllabus/IT277-cloud-computing.md",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/_syllabus/(.*)",
      "destination": "/_syllabus/$1.md"
    },
    {
      "source": "/bi/(unit-[0-9]+|model-question|model-question-answers|question-bank)",
      "destination": "/bi/$1.html/"
    },
    {
      "source": "/de/(unit-[0-9]+|model-question|model-question-answers|question-bank)",
      "destination": "/de/$1.html/"
    },
    {
      "source": "/cloud/(unit-[0-9]+|model-question|model-question-answers|question-bank)",
      "destination": "/cloud/$1.html/"
    },
    {
      "source": "/entrepreneurship/(unit-[0-9]+|model-question|model-question-answers|question-bank)",
      "destination": "/entrepreneurship/$1.html/"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}