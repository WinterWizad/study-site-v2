{
  "name": "study-site-v2",
  "version": "1.0.0",
  "description": "BIM 8th Semester Study Site - HTML Rendered",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "build:narrated": "npm run build && node scripts/prime-narration.mjs --require",
    "narrate:prime": "npm run build && node scripts/prime-narration.mjs",
    "narrate:prime:all": "npm run build && node scripts/prime-narration.mjs --all",
    "serve": "npx serve dist -l 8080",
    "test": "npm run build && npm run test:routes && npm run test:reels:content && npm run test:narration && npm run test:reels:browser",
    "test:home": "node test-homepage.cjs",
    "test:mobile": "node test-mobile.cjs",
    "test:comprehensive": "node test-comprehensive.cjs",
    "test:routes": "node test-clean-routes.cjs",
    "test:reels:content": "node test-reels-content.mjs",
    "test:narration": "node test-narration.mjs",
    "test:reels:browser": "node test-reels.cjs",
    "test:reels": "npm run build && npm run test:reels:content && npm run test:narration && npm run test:reels:browser"
  },
  "dependencies": {
    "front-matter": "^4.0.2",
    "glob": "^10.3.10",
    "marked": "^12.0.0"
  },
  "type": "module"
}
